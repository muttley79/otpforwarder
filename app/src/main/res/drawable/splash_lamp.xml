<?xml version="1.0" encoding="utf-8"?>
<!-- The one launch moment: the core lights, then the halo opens around it. Under a second, as the system requires. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/splash_lamp_vector">

    <target android:name="core">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="320"
                android:propertyName="fillAlpha"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>

    <target android:name="halo">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="520"
                android:propertyName="strokeAlpha"
                android:startOffset="180"
                android:valueFrom="0"
                android:valueTo="0.65"
                android:valueType="floatType" />
        </aapt:attr>
    </target>

    <target android:name="halo_group">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:duration="520"
                    android:interpolator="@android:interpolator/decelerate_quad"
                    android:propertyName="scaleX"
                    android:startOffset="180"
                    android:valueFrom="0.45"
                    android:valueTo="1"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="520"
                    android:interpolator="@android:interpolator/decelerate_quad"
                    android:propertyName="scaleY"
                    android:startOffset="180"
                    android:valueFrom="0.45"
                    android:valueTo="1"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
